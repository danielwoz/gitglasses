{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-linux",
        "VCPKG_INSTALLED_DIR": "$env{HOME}/.cache/gitglasses/vcpkg_installed",
        "VCPKG_MANIFEST_INSTALL": "OFF"
      }
    },
    {
      "name": "debug",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "debug-st",
      "inherits": "debug",
      "cacheVariables": { "GG_SINGLE_THREADED": "ON" }
    },
    {
      "name": "wasm",
      "vendor": {
        "gitglasses": {
          "notes": "Emscripten build of the engine as an ES6 wasm module. Requires emsdk in the environment (source emsdk_env.sh) and prebuilt wasm deps under ~/.cache/gitglasses/vcpkg_wasm. There is no ctest preset; test with `node engine/wasm-test/run.mjs` (plain Node >= 20, no pnpm or package install needed)."
        }
      },
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "VCPKG_TARGET_TRIPLET": "wasm32-emscripten-gg",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/ci/triplets",
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
        "VCPKG_INSTALLED_DIR": "$env{HOME}/.cache/gitglasses/vcpkg_wasm",
        "VCPKG_MANIFEST_INSTALL": "OFF",
        "GG_SINGLE_THREADED": "ON",
        "GG_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
    },
    {
      "name": "mingw",
      "vendor": {
        "gitglasses": {
          "notes": "Windows cross-build with mingw-w64 for local verification under wine. Requires x86_64-w64-mingw32-g++ on the host and prebuilt deps under ~/.cache/gitglasses/vcpkg_mingw (vcpkg triplet x64-mingw-static). Run tests with wine, e.g. WINEPATH=<mingit>/cmd wine build/mingw/engine/tests/engine_tests.exe."
        }
      },
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "VCPKG_TARGET_TRIPLET": "x64-mingw-static",
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/ci/mingw-toolchain.cmake",
        "VCPKG_INSTALLED_DIR": "$env{HOME}/.cache/gitglasses/vcpkg_mingw",
        "VCPKG_MANIFEST_INSTALL": "OFF",
        "GG_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "asan",
      "inherits": "debug",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    },
    {
      "name": "tsan",
      "inherits": "debug",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-fsanitize=thread -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=thread"
      }
    },
    {
      "name": "macos",
      "hidden": true,
      "vendor": {
        "gitglasses": {
          "notes": "Apple Silicon. Install deps with: $VCPKG_ROOT/vcpkg install --triplet arm64-osx-gg --overlay-triplets=ci/triplets --x-install-root=$HOME/.cache/gitglasses/vcpkg_installed. On an Intel Mac add -DVCPKG_TARGET_TRIPLET=x64-osx-gg and install that triplet instead."
        }
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "arm64-osx-gg",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/ci/triplets",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "11.0"
      }
    },
    {
      "name": "macos-debug",
      "displayName": "macOS debug",
      "inherits": ["macos", "debug"],
      "binaryDir": "${sourceDir}/build/debug"
    },
    {
      "name": "macos-release",
      "displayName": "macOS release",
      "inherits": ["macos", "release"],
      "binaryDir": "${sourceDir}/build/release"
    },
    {
      "name": "windows",
      "hidden": true,
      "vendor": {
        "gitglasses": {
          "notes": "x64 with the static MSVC runtime; run from a Visual Studio developer prompt so Ninja finds cl.exe. Install deps with: & $env:VCPKG_ROOT\\vcpkg.exe install --triplet x64-windows-static --x-install-root=$env:USERPROFILE\\.cache\\gitglasses\\vcpkg_installed. On arm64 add -DVCPKG_TARGET_TRIPLET=arm64-windows-static and install that triplet instead."
        }
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-static",
        "VCPKG_INSTALLED_DIR": "$env{USERPROFILE}/.cache/gitglasses/vcpkg_installed"
      }
    },
    {
      "name": "windows-debug",
      "displayName": "Windows debug",
      "inherits": ["windows", "debug"],
      "binaryDir": "${sourceDir}/build/debug"
    },
    {
      "name": "windows-release",
      "displayName": "Windows release",
      "inherits": ["windows", "release"],
      "binaryDir": "${sourceDir}/build/release"
    },
    {
      "name": "linux-arm64",
      "hidden": true,
      "vendor": {
        "gitglasses": {
          "notes": "Install deps with: $VCPKG_ROOT/vcpkg install --triplet arm64-linux --x-install-root=$HOME/.cache/gitglasses/vcpkg_installed"
        }
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "cacheVariables": { "VCPKG_TARGET_TRIPLET": "arm64-linux" }
    },
    {
      "name": "linux-arm64-debug",
      "displayName": "Linux arm64 debug",
      "inherits": ["linux-arm64", "debug"],
      "binaryDir": "${sourceDir}/build/debug"
    },
    {
      "name": "linux-arm64-release",
      "displayName": "Linux arm64 release",
      "inherits": ["linux-arm64", "release"],
      "binaryDir": "${sourceDir}/build/release"
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "debug-st", "configurePreset": "debug-st" },
    { "name": "wasm", "configurePreset": "wasm" },
    { "name": "mingw", "configurePreset": "mingw" },
    { "name": "release", "configurePreset": "release" },
    { "name": "asan", "configurePreset": "asan" },
    { "name": "tsan", "configurePreset": "tsan" },
    { "name": "macos-debug", "configurePreset": "macos-debug" },
    { "name": "macos-release", "configurePreset": "macos-release" },
    { "name": "windows-debug", "configurePreset": "windows-debug" },
    { "name": "windows-release", "configurePreset": "windows-release" },
    { "name": "linux-arm64-debug", "configurePreset": "linux-arm64-debug" },
    { "name": "linux-arm64-release", "configurePreset": "linux-arm64-release" }
  ],
  "testPresets": [
    { "name": "debug", "configurePreset": "debug", "output": { "outputOnFailure": true } },
    { "name": "debug-st", "configurePreset": "debug-st", "output": { "outputOnFailure": true } },
    { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true } },
    { "name": "asan", "configurePreset": "asan", "output": { "outputOnFailure": true } },
    { "name": "tsan", "configurePreset": "tsan", "output": { "outputOnFailure": true } },
    { "name": "macos-debug", "configurePreset": "macos-debug", "output": { "outputOnFailure": true } },
    { "name": "macos-release", "configurePreset": "macos-release", "output": { "outputOnFailure": true } },
    { "name": "windows-debug", "configurePreset": "windows-debug", "output": { "outputOnFailure": true } },
    { "name": "windows-release", "configurePreset": "windows-release", "output": { "outputOnFailure": true } },
    { "name": "linux-arm64-debug", "configurePreset": "linux-arm64-debug", "output": { "outputOnFailure": true } },
    { "name": "linux-arm64-release", "configurePreset": "linux-arm64-release", "output": { "outputOnFailure": true } }
  ]
}
