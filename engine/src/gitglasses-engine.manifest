<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Makes the process code page UTF-8 (Windows 10 1903 and later), so narrow
     Win32 and CRT calls - argv, getenv, fopen and the like - read and write
     paths and text as UTF-8, the encoding the engine uses everywhere. -->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity type="win32" name="GitGlasses.Engine" version="1.0.0.0"/>
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
