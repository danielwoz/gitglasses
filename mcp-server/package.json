{
  "name": "gitglasses-mcp",
  "version": "0.2.0",
  "description": "MCP server that gives AI agents GitGlasses repository insight: blame, history, the commit graph, status, diffs, patches and pull requests",
  "license": "MIT",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "git",
    "blame",
    "gitglasses"
  ],
  "homepage": "https://github.com/danielwoz/gitglasses/tree/main/mcp-server#readme",
  "bugs": {
    "url": "https://github.com/danielwoz/gitglasses/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielwoz/gitglasses.git",
    "directory": "mcp-server"
  },
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "bin": {
    "gitglasses-mcp": "dist/cli.js"
  },
  "files": [
    "dist/cli.js"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node esbuild.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@sinclair/typebox": "^0.34.52",
    "zod": "^3.25.1"
  },
  "devDependencies": {
    "@gitglasses/integrations": "workspace:*",
    "@gitglasses/protocol": "workspace:*",
    "@gitglasses/rpc": "workspace:*",
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
