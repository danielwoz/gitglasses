        "category": "GitGlasses"
      },
      {
        "command": "gitglasses.selectRepository",
        "title": "Select Repository…",
        "category": "GitGlasses",
        "icon": "$(repo)"
      },
      {
        "command": "gitglasses.shortcut.showGraph",
        "title": "Show Commit Graph (Keyboard Shortcut)",
        "category": "GitGlasses"
      },
      {
        "command": "gitglasses.shortcut.toggleLineBlame",
        "title": "Toggle Inline Blame (Keyboard Shortcut)",
        "category": "GitGlasses"
      },
      {
        "command": "gitglasses.shortcut.toggleFileBlame",
        "title": "Toggle File Blame Annotations (Keyboard Shortcut)",
        "category": "GitGlasses"
      },
      {
        "command": "gitglasses.shortcut.showFileHistory",
        "title": "Show Visual File History (Keyboard Shortcut)",
        "category": "GitGlasses",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "gitglasses.shortcut.searchCommits",
        "title": "Search Commits… (Keyboard Shortcut)",
        "category": "GitGlasses"
      },
      {
        "command": "gitglasses.shortcut.gitCommands",
        "title": "Git Commands… (Keyboard Shortcut)",
        "category": "GitGlasses",
        "enablement": "isWorkspaceTrusted"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gitglasses",
          "title": "GitGlasses",
          "icon": "media/gitglasses.svg"
        }
      ]
    },
    "views": {
      "gitglasses": [
        {
          "id": "gitglasses.views.home",
          "name": "Home"
        },
        {
          "id": "gitglasses.views.commits",
          "name": "Commits"
        },
        {
          "id": "gitglasses.views.branches",
          "name": "Branches",
          "visibility": "collapsed"
        },
        {
          "id": "gitglasses.views.fileHistory",
          "name": "File History"
        },
        {
          "id": "gitglasses.views.worktrees",
          "name": "Worktrees",
          "visibility": "collapsed"
        },
        {
          "id": "gitglasses.views.searchCompare",
          "name": "Search & Compare",
          "visibility": "collapsed"
        },
        {
          "id": "gitglasses.views.launchpad",
          "name": "Launchpad",
          "visibility": "collapsed"
        },
        {
          "id": "gitglasses.views.stashes",
          "name": "Stashes",
          "visibility": "hidden"
        },
        {
          "id": "gitglasses.views.tags",
          "name": "Tags",
          "visibility": "hidden"
        },
        {
          "id": "gitglasses.views.remotes",
          "name": "Remotes",
          "visibility": "hidden"
        },
        {
          "id": "gitglasses.views.contributors",
          "name": "Contributors",
          "visibility": "hidden"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "gitglasses.getStarted",
        "title": "Get Started with GitGlasses",
        "description": "Every feature is free and works offline. There is no account to create and nothing to sign in to.",
        "steps": [
          {
            "id": "graph",
            "title": "Read your history in the Commit Graph",
            "description": "The graph shows branches, merges and authorship together, on public and private repositories alike.\n[Show Commit Graph](command:gitglasses.showGraph)",
            "media": {
              "markdown": "media/walkthrough/graph.md"
            },
            "completionEvents": [
              "onCommand:gitglasses.showGraph"
            ]
          },
          {
            "id": "blame",
            "title": "See who changed a line, as you type",
            "description": "Inline blame annotates the current line. File blame and the heatmap annotate the whole file.\n[Toggle Inline Blame](command:gitglasses.toggleLineBlame)",
            "media": {
              "markdown": "media/walkthrough/blame.md"
            },
            "completionEvents": [
              "onCommand:gitglasses.toggleLineBlame"
            ]
          },
          {
            "id": "fileHistory",
            "title": "Trace a file over time",
            "description": "Visual File History plots each revision by size and author, so churn is obvious at a glance.\n[Show Visual File History](command:gitglasses.showFileHistory)",
            "media": {
              "markdown": "media/walkthrough/history.md"
            },
            "completionEvents": [
              "onCommand:gitglasses.showFileHistory"
            ]
          },
          {
            "id": "remote",
            "title": "Jump to the file on your forge",
            "description": "Open the current file, at the current line, on GitHub, GitLab or Bitbucket.\n[Open File on Remote](command:gitglasses.openOnRemote)",
            "media": {
              "markdown": "media/walkthrough/remote.md"
            },
            "completionEvents": [
              "onCommand:gitglasses.openOnRemote"
            ]
          },
          {
            "id": "worktrees",
            "title": "Work on two branches at once",
            "description": "Worktrees check out another branch in a separate folder, so you can review a pull request without stashing.\n[Add Worktree…](command:gitglasses.worktrees.add)",
            "media": {
              "markdown": "media/walkthrough/worktrees.md"
            },
            "completionEvents": [
              "onCommand:gitglasses.worktrees.add"
            ]
          },
          {
            "id": "ai",
            "title": "Bring your own AI key, or none at all",
            "description": "Explain a commit or draft a commit message using your own API key or a local Ollama model. Nothing is metered and nothing is sent to us.\n[Set AI API Key…](command:gitglasses.ai.setApiKey)",
            "media": {
              "markdown": "media/walkthrough/ai.md"
            },
            "completionEvents": [
              "onCommand:gitglasses.ai.setApiKey",
              "onCommand:gitglasses.ai.explainCommit"
            ]
          },
          {
            "id": "integrations",
            "title": "Connect issues and pull requests",
            "description": "Launchpad gathers your pull requests and issues. Connect a forge or issue tracker, cloud or self-hosted, without editing settings by hand.\n[Connect Integration…](command:gitglasses.connectIntegration)",
            "media": {
              "markdown": "media/walkthrough/integrations.md"
            },
            "completionEvents": [
              "onCommand:gitglasses.addIntegration",
              "onCommand:gitglasses.connectIntegration"
            ]
          }
        ]
      }
    ],
    "keybindings": [
      {
        "command": "gitglasses.shortcut.showGraph",
        "key": "ctrl+alt+g g",
        "mac": "cmd+alt+g g",
        "when": "config.gitglasses.keyboardShortcuts.enabled && !terminalFocus"
      },
      {
        "command": "gitglasses.shortcut.toggleLineBlame",
        "key": "ctrl+alt+g b",
        "mac": "cmd+alt+g b",
        "when": "config.gitglasses.keyboardShortcuts.enabled && editorTextFocus"
      },
      {
        "command": "gitglasses.shortcut.toggleFileBlame",
        "key": "ctrl+alt+g shift+b",
        "mac": "cmd+alt+g shift+b",
        "when": "config.gitglasses.keyboardShortcuts.enabled && editorTextFocus"
      },
      {
        "command": "gitglasses.shortcut.showFileHistory",
        "key": "ctrl+alt+g h",
        "mac": "cmd+alt+g h",
        "when": "config.gitglasses.keyboardShortcuts.enabled && editorTextFocus"
      },
      {
        "command": "gitglasses.shortcut.searchCommits",
        "key": "ctrl+alt+g f",
        "mac": "cmd+alt+g f",
        "when": "config.gitglasses.keyboardShortcuts.enabled && !terminalFocus"
      },
      {
        "command": "gitglasses.shortcut.gitCommands",
        "key": "ctrl+alt+g c",
        "mac": "cmd+alt+g c",
        "when": "config.gitglasses.keyboardShortcuts.enabled && !terminalFocus"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "gitglasses.selectRepository",
          "when": "view =~ /^gitglasses\\.views\\./ && gitglasses.multiRepoWorkspace",
          "group": "navigation@1"
        },
        {
          "command": "gitglasses.showGraph",
          "when": "view =~ /^gitglasses\\.views\\./",
          "group": "navigation@0"
        },
        {
          "command": "gitglasses.refreshViews",
          "when": "view =~ /^gitglasses\\.views\\./ && view != gitglasses.views.launchpad",
          "group": "navigation"
        },
        {
          "command": "gitglasses.launchpad.refresh",
          "when": "view == gitglasses.views.launchpad",
          "group": "navigation"
        },
        {
          "command": "gitglasses.searchCommits",
          "when": "view == gitglasses.views.searchCompare",
          "group": "navigation"
        },
        {
          "command": "gitglasses.showGraph",
          "when": "view == gitglasses.views.commits",
          "group": "navigation"
        },
        {
          "command": "gitglasses.worktrees.add",
          "when": "view == gitglasses.views.worktrees && isWorkspaceTrusted",
          "group": "navigation"
        },
        {
          "command": "gitglasses.showFileHistory",
          "when": "view == gitglasses.views.fileHistory && isWorkspaceTrusted",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "gitglasses.showFileHistory",
          "when": "resourceScheme == file && isWorkspaceTrusted",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "gitglasses.suggestChange",
          "when": "editorHasSelection && resourceScheme == file && isWorkspaceTrusted",
          "group": "gitglasses@1"
        },
        {
          "command": "gitglasses.openOnRemote",
          "when": "resourceScheme == file",
          "group": "gitglasses@2"
        },
        {
          "command": "gitglasses.copyRemoteUrl",
          "when": "resourceScheme == file",
          "group": "gitglasses@3"
        },
        {
          "command": "gitglasses.stageSelectedHunks",
          "when": "resourceScheme == file && isWorkspaceTrusted",
          "group": "gitglasses@4"
        },
        {
          "command": "gitglasses.unstageSelectedHunks",
          "when": "resourceScheme == file && isWorkspaceTrusted",
          "group": "gitglasses@5"
        }
      ],
      "view/item/context": [
        {
          "command": "gitglasses.copySha",
          "when": "view =~ /^gitglasses\\.views\\./ && viewItem =~ /^gitglasses(Commit|FileHistoryEntry|Branch|CurrentBranch|RemoteBranch|Tag|Stash)$/"
        },
        {
          "command": "gitglasses.openCommitDiff",
          "when": "view =~ /^gitglasses\\.views\\./ && viewItem =~ /^gitglasses(Commit|FileHistoryEntry)$/"
        },
        {
          "command": "gitglasses.openCommitOnRemote",
          "when": "view =~ /^gitglasses\\.views\\./ && viewItem =~ /^gitglasses(Commit|FileHistoryEntry)$/"
        },
        {
          "command": "gitglasses.ai.explainCommit",
          "when": "view =~ /^gitglasses\\.views\\./ && viewItem == gitglassesCommit"
        },
        {
          "command": "gitglasses.createPatch",
          "when": "view =~ /^gitglasses\\.views\\./ && viewItem =~ /^gitglasses(Commit|Stash)$/ && isWorkspaceTrusted"
        },
        {
          "command": "gitglasses.worktrees.open",
          "when": "view == gitglasses.views.worktrees && viewItem =~ /^gitglasses(Current)?Worktree$/",
          "group": "inline"
        },
        {
          "command": "gitglasses.worktrees.open",
          "when": "view == gitglasses.views.worktrees && viewItem =~ /^gitglasses(Current)?Worktree$/"
        },
        {
          "command": "gitglasses.worktrees.remove",
          "when": "view == gitglasses.views.worktrees && viewItem == gitglassesWorktree && isWorkspaceTrusted"
        },
        {
          "command": "gitglasses.launchpad.open",
          "when": "view == gitglasses.views.launchpad && viewItem =~ /^gitglassesLaunchpad(Snoozed)?Pr$/"
        },
        {
          "command": "gitglasses.launchpad.copyUrl",
          "when": "view == gitglasses.views.launchpad && viewItem =~ /^gitglassesLaunchpad(Snoozed)?Pr$/"
        },
        {
          "command": "gitglasses.launchpad.snooze",
          "when": "view == gitglasses.views.launchpad && viewItem == gitglassesLaunchpadPr"
        },
        {
          "command": "gitglasses.launchpad.unsnooze",
          "when": "view == gitglasses.views.launchpad && viewItem == gitglassesLaunchpadSnoozedPr"
        }
      ],
      "commandPalette": [
        {
          "command": "gitglasses.toggleLineBlame",
          "when": "gitglasses.hasRepository"
        },
        {
          "command": "gitglasses.toggleFileBlame",
          "when": "gitglasses.hasRepository && resourceScheme == file"
        },
        {
          "command": "gitglasses.toggleHeatmap",
          "when": "gitglasses.hasRepository && resourceScheme == file"
        },
        {
          "command": "gitglasses.toggleChanges",
          "when": "gitglasses.hasRepository && resourceScheme == file"
        },
        {
          "command": "gitglasses.clearAnnotations",
          "when": "gitglasses.hasRepository && resourceScheme == file"
        },
        {
          "command": "gitglasses.diffWithHead",
          "when": "gitglasses.hasRepository && (resourceScheme == file || isWeb)"
        },
        {
          "command": "gitglasses.openFileAtRevision",
          "when": "gitglasses.hasRepository && (resourceScheme == file || isWeb)"
        },
        {
          "command": "gitglasses.refreshViews",
          "when": "gitglasses.hasRepository"
        },
        {
          "command": "gitglasses.searchCommits",
          "when": "gitglasses.hasRepository"
        },
        {
          "command": "gitglasses.showLineHistory",
          "when": "gitglasses.hasRepository && (resourceScheme == file || isWeb) && isWorkspaceTrusted"
        },
        {
          "command": "gitglasses.copySha",
          "when": "false"
        },
        {
          "command": "gitglasses.openCommitDiff",
          "when": "false"
        },
        {
          "command": "gitglasses.showCommitDetails",
          "when": "false"
        },
        {
          "command": "gitglasses.showGraph",
          "when": "gitglasses.hasRepository"
        },
        {
          "command": "gitglasses.showFileHistory",
          "when": "gitglasses.hasRepository && (resourceScheme == file || isWeb) && isWorkspaceTrusted"
        },
        {
          "command": "gitglasses.groups.create",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "gitglasses.gitCommands",
          "when": "gitglasses.hasRepository && isWorkspaceTrusted"
        },
        {
          "command": "gitglasses.interactiveRebase",
          "when": "gitglasses.hasRepository && isWorkspaceTrusted && gitglasses.engineFullCapabilities"
        },
        {
          "command": "gitglasses.worktrees.add",
          "when": "gitglasses.hasRepository && isWorkspaceTrusted"
        },
        {
          "command": "gitglasses.worktrees.open",
          "when": "false"
        },
        {
          "command": "gitglasses.worktrees.remove",
          "when": "false"
        },
        {
          "command": "gitglasses.startWork",
          "when": "gitglasses.hasRepository && isWorkspaceTrusted"
        },
        {
          "command": "gitglasses.launchpad.open",
          "when": "false"
        },
        {
          "command": "gitglasses.launchpad.copyUrl",
          "when": "false"
        },
        {
          "command": "gitglasses.launchpad.snooze",
          "when": "false"
        },
        {
          "command": "gitglasses.launchpad.unsnooze",
          "when": "false"
        },
        {
          "command": "gitglasses.ai.explainCommit",
          "when": "gitglasses.hasRepository"
        },
        {
          "command": "gitglasses.ai.explainWip",
          "when": "gitglasses.hasRepository"
        },
        {
          "command": "gitglasses.ai.generateCommitMessage",
          "when": "gitglasses.hasRepository && isWorkspaceTrusted"
        },
        {
          "command": "gitglasses.ai.nlSearch",
          "when": "gitglasses.hasRepository"
        },
        {
          "command": "gitglasses.createPatch",
          "when": "gitglasses.hasRepository && isWorkspaceTrusted && gitglasses.engineFullCapabilities"
        },
        {
          "command": "gitglasses.applyPatch",
          "when": "gitglasses.hasRepository && isWorkspaceTrusted && gitglasses.engineFullCapabilities"
        },
        {
          "command": "gitglasses.suggestChange",
          "when": "gitglasses.hasRepository && editorHasSelection && resourceScheme == file && isWorkspaceTrusted"
        },
        {
          "command": "gitglasses.home.push",
          "when": "false"
        },
        {
          "command": "gitglasses.home.pull",
          "when": "false"
        },
        {
          "command": "gitglasses.home.switchBranch",
          "when": "false"
        },
        {
          "command": "gitglasses.home.createBranch",
          "when": "false"
        },
        {
          "command": "gitglasses.home.dismissGetStarted",
          "when": "false"
        },
        {
          "command": "gitglasses.openOnRemote",
          "when": "gitglasses.hasRepository && resourceScheme == file"
        },
        {
          "command": "gitglasses.copyRemoteUrl",
          "when": "gitglasses.hasRepository && resourceScheme == file"
        },
        {
          "command": "gitglasses.openCommitOnRemote",
          "when": "false"
        },
        {
          "command": "gitglasses.stageSelectedHunks",
          "when": "gitglasses.hasRepository && resourceScheme == file && isWorkspaceTrusted"
        },
        {
          "command": "gitglasses.unstageSelectedHunks",
          "when": "gitglasses.hasRepository && resourceScheme == file && isWorkspaceTrusted"
        },
        {
          "command": "gitglasses.addIntegration",
          "when": "false"
        },
        {
          "command": "gitglasses.selectRepository",
          "when": "gitglasses.multiRepoWorkspace"
        },
        {
          "command": "gitglasses.shortcut.showGraph",
          "when": "false"
        },
        {
          "command": "gitglasses.shortcut.toggleLineBlame",
          "when": "false"
        },
        {
          "command": "gitglasses.shortcut.toggleFileBlame",
          "when": "false"
        },
        {
          "command": "gitglasses.shortcut.showFileHistory",
          "when": "false"
        },
        {
          "command": "gitglasses.shortcut.searchCommits",
          "when": "false"
        },
        {
          "command": "gitglasses.shortcut.gitCommands",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "GitGlasses",
      "properties": {
        "gitglasses.mode": {
          "type": "string",
          "scope": "window",
          "enum": [
            "normal",
            "zen",
            "review"
          ],
          "enumDescriptions": [
            "Annotations and CodeLens follow their individual settings",
            "Distraction-free: hide inline blame, status bar blame, file annotations, and blame CodeLens",
            "Review: gutter blame annotations forced on in the editors you open"
          ],
          "default": "normal",
          "description": "GitGlasses mode; switch via the status bar item or the Switch Mode command"
        },
        "gitglasses.keyboardShortcuts.enabled": {
          "type": "boolean",
          "scope": "window",
          "default": false,
          "markdownDescription": "Turn on GitGlasses keyboard shortcuts: `Ctrl+Alt+G` (`Cmd+Alt+G` on macOS), then `G` Commit Graph, `B` inline blame, `Shift+B` file blame, `H` visual file history, `F` search commits or `C` Git Commands. Off by default, so none of the editor's own shortcuts are taken over. On Windows keyboard layouts where `AltGr+G` types a character, leave this off and bind the commands in Keyboard Shortcuts instead."
        },
        "gitglasses.currentLine.enabled": {
          "type": "boolean",
          "scope": "window",
          "default": true,
          "description": "Show blame annotation for the current line"
        },
        "gitglasses.views.pageSize": {
          "type": "number",
          "scope": "window",
          "default": 50,
          "minimum": 10,
          "maximum": 1000,
          "description": "Commits loaded per page in the Commits and File History views"
        },
        "gitglasses.graph.pageSize": {
          "type": "number",
          "scope": "window",
          "default": 200,
          "minimum": 50,
          "maximum": 5000,
          "description": "Rows loaded per page in the Commit Graph and Visual File History"
        },
        "gitglasses.codeLens.enabled": {
          "type": "boolean",
          "scope": "window",
          "default": true,
          "description": "Show git blame CodeLens above files and top-level symbols"
        },
        "gitglasses.engine.path": {
          "type": "string",
          "scope": "machine-overridable",
          "default": "",
          "description": "Path to gitglasses-engine (defaults to the bundled binary)"
        },
        "gitglasses.web.maxRepoBytes": {
          "type": "number",
          "scope": "machine-overridable",
          "default": 209715200,
          "description": "Web only: maximum total bytes mirrored into the in-memory wasm engine before GitGlasses aborts with an error (default 200 MB)"
        },
        "gitglasses.engine.logLevel": {
          "type": "string",
          "scope": "window",
          "enum": [
            "trace",
            "debug",
            "info",
            "warn",
            "error"
          ],
          "default": "warn",
          "description": "Engine log level (logs go to the GitGlasses output channel)"
        },
        "gitglasses.integrations.hosts": {
          "type": "array",
          "scope": "machine-overridable",
          "default": [],
          "description": "Git hosting instances beyond github.com, gitlab.com and bitbucket.org, e.g. [{ \"domain\": \"github.example.com\", \"provider\": \"github-enterprise\" }]. Azure DevOps takes dev.azure.com plus an organization.",
          "items": {
            "type": "object",
            "required": [
              "domain",
              "provider"
            ],
            "properties": {
              "domain": {
                "type": "string",
                "description": "Hostname of the instance, e.g. github.example.com"
              },
              "provider": {
                "type": "string",
                "enum": [
                  "github",
                  "github-enterprise",
                  "gitlab",
                  "bitbucket",
                  "bitbucketDC",
                  "azuredevops"
                ],
                "enumDescriptions": [
                  "GitHub (github.com; any other domain is treated as GitHub Enterprise Server)",
                  "GitHub Enterprise Server",
                  "GitLab (gitlab.com or self-managed)",
                  "Bitbucket Cloud (bitbucket.org only)",
                  "Bitbucket Data Center",
                  "Azure DevOps Services (dev.azure.com only; needs organization)"
                ],
                "description": "Provider serving this domain"
              },
              "organization": {
                "type": "string",
                "description": "Azure DevOps organization, e.g. contoso for https://dev.azure.com/contoso"
              }
            }
          }
        },
        "gitglasses.integrations.issues": {
          "type": "array",
          "scope": "machine-overridable",
          "default": [],
          "description": "Issue tracker integrations, e.g. [{ \"provider\": \"jira\", \"host\": \"mycompany.atlassian.net\" }]",
          "items": {
            "type": "object",
            "required": [
              "provider"
            ],
            "properties": {
              "provider": {
                "type": "string",
                "enum": [
                  "jira",
                  "linear",
                  "github",
                  "github-enterprise"
                ],
                "enumDescriptions": [
                  "Jira Cloud (*.atlassian.net)",
                  "Linear",
                  "GitHub Issues (github.com unless host names a GitHub Enterprise Server)",
                  "GitHub Enterprise Server issues"
                ],
                "description": "Issue tracker"
              },
              "host": {
                "type": "string",
                "description": "Tracker host: the Jira Cloud site (e.g. mycompany.atlassian.net) or the GitHub Enterprise Server hostname"
              }
            }
          }
        },
        "gitglasses.ai.provider": {
          "type": "string",
          "scope": "machine-overridable",
          "enum": [
            "vscode-lm",
            "anthropic",
            "openai",
            "gemini",
            "ollama"
          ],
          "enumDescriptions": [
            "VS Code Language Model API (GitHub Copilot) — zero configuration when available",
            "Anthropic Claude API (bring your own key)",
            "OpenAI API or any compatible endpoint (bring your own key)",
            "Google Gemini API (bring your own key)",
            "Local Ollama server — no key, data stays on your machine"
          ],
          "default": "vscode-lm",
          "description": "AI provider used by the GitGlasses AI commands"
        },
        "gitglasses.ai.model": {
          "type": "string",
          "scope": "machine-overridable",
          "default": "",
          "description": "Model id for the selected AI provider (empty = provider default)"
        },
        "gitglasses.ai.openai.baseUrl": {
          "type": "string",
          "scope": "machine",
          "default": "",
          "description": "Base URL for OpenAI-compatible endpoints (empty = https://api.openai.com/v1)"
        },
        "gitglasses.ai.ollama.host": {
          "type": "string",
          "scope": "machine",
          "default": "",
          "description": "Ollama server URL (empty = http://localhost:11434)"
        },
        "gitglasses.autolinks": {
          "type": "array",
          "scope": "machine-overridable",
          "default": [],
          "description": "Custom autolink patterns applied to commit messages, e.g. [{ \"regex\": \"TICKET-(\\\\d+)\", \"urlTemplate\": \"https://tracker.example.com/browse/TICKET-$1\" }]",
          "items": {
            "type": "object",
            "required": [
              "regex",
              "urlTemplate"
            ],
            "properties": {
              "regex": {
                "type": "string",
                "description": "Regular expression matching the reference text"
              },
              "urlTemplate": {
                "type": "string",
                "description": "Target URL; capture groups referenced as $1, $2, …"
              }
            }
          }
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "test": "vitest run",
    "test:e2e": "node esbuild.mjs && tsc -p test-e2e/tsconfig.json && node test-e2e/headless.cjs",
    "test:web": "node esbuild.mjs && node test-web/runTests.mjs",
    "package": "node ../scripts/package-vsix.mjs"
  },
  "dependencies": {
    "@gitglasses/integrations": "workspace:*",
    "@gitglasses/protocol": "workspace:*",
    "@gitglasses/rpc": "workspace:*"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.0.0",
    "@types/vscode": "~1.90.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/test-web": "^0.0.81",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.24.0",
    "mocha": "^10.8.2",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
