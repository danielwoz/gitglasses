{
  "name": "gitglasses",
  "displayName": "GitGlasses",
  "description": "Open-source git supercharger: inline blame, history, and more — powered by a native engine",
  "version": "0.2.0",
  "publisher": "gitglasses",
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1b1f2a",
    "theme": "dark"
  },
  "homepage": "https://github.com/danielwoz/gitglasses#readme",
  "bugs": {
    "url": "https://github.com/danielwoz/gitglasses/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/danielwoz/gitglasses.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "SCM Providers",
    "Visualization",
    "Education"
  ],
  "keywords": [
    "git",
    "blame",
    "commit graph",
    "history",
    "worktrees"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In Restricted Mode GitGlasses runs no git commands, so no program the repository configures (hooks, filters, fsmonitor, diff drivers, ssh commands) can run: blame, commit history and the commit graph are read straight from the repository, while file and line history, patches and every command that changes the repository or contacts a remote stay off until the folder is trusted. Settings that choose an executable, a network endpoint or a link target are read from user settings only.",
      "restrictedConfigurations": [
        "gitglasses.engine.path",
        "gitglasses.web.maxRepoBytes",
        "gitglasses.integrations.hosts",
        "gitglasses.integrations.issues",
        "gitglasses.ai.provider",
        "gitglasses.ai.model",
        "gitglasses.ai.openai.baseUrl",
        "gitglasses.ai.ollama.host",
        "gitglasses.autolinks"
      ]
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "browser": "./dist/web/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "gitglasses.toggleLineBlame",
        "title": "Toggle Inline Blame",
        "category": "GitGlasses"
      },
      {
        "command": "gitglasses.toggleFileBlame",
        "title": "Toggle File Blame Annotations",
        "category": "GitGlasses"
      },
      {
        "command": "gitglasses.toggleHeatmap",
        "title": "Toggle File Heatmap Annotations",
        "category": "GitGlasses"
      },
      {
        "command": "gitglasses.toggleChanges",
        "title": "Toggle File Changes Annotations",
        "category": "GitGlasses"
      },
      {
        "command": "gitglasses.clearAnnotations",
        "title": "Clear File Annotations",
        "category": "GitGlasses"
      },
      {
        "command": "gitglasses.diffWithHead",
        "title": "Open Changes with HEAD",
        "category": "GitGlasses"
      },
      {
        "command": "gitglasses.openFileAtRevision",
        "title": "Open File at Revision",
        "category": "GitGlasses"
      },
      {
        "command": "gitglasses.restartEngine",
        "title": "Restart Engine",
        "category": "GitGlasses"
      },
      {
        "command": "gitglasses.refreshViews",
        "title": "Refresh Views",
        "category": "GitGlasses",
        "icon": "$(refresh)"
      },
      {
        "command": "gitglasses.searchCommits",
        "title": "Search Commits…",
        "category": "GitGlasses",
        "icon": "$(search)"
      },
      {
        "command": "gitglasses.showLineHistory",
        "title": "Show Line History for Selection",
        "category": "GitGlasses",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "gitglasses.copySha",
        "title": "Copy SHA",
        "category": "GitGlasses"
      },
      {
        "command": "gitglasses.openCommitDiff",
        "title": "Open Commit",
        "category": "GitGlasses"
      },
      {
        "command": "gitglasses.showCommitDetails",
        "title": "Show Commit Details",
        "category": "GitGlasses"
      },
      {
        "command": "gitglasses.showGraph",
        "title": "Show Commit Graph",
        "category": "GitGlasses",
        "icon": "$(git-branch)"
      },
      {
        "command": "gitglasses.showFileHistory",
        "title": "Show Visual File History",
        "category": "GitGlasses",
        "icon": "$(graph-scatter)",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "gitglasses.groups.create",
        "title": "Create Repo Group from Workspace",
        "category": "GitGlasses"
      },
      {
        "command": "gitglasses.groups.open",
        "title": "Open Repo Group in New Window",
        "category": "GitGlasses"
      },
      {
        "command": "gitglasses.groups.delete",
        "title": "Delete Repo Group",
        "category": "GitGlasses"
      },
      {
        "command": "gitglasses.groups.export",
        "title": "Export Repo Group…",
        "category": "GitGlasses"
      },
      {
        "command": "gitglasses.groups.import",
        "title": "Import Repo Group…",
        "category": "GitGlasses"
      },
      {
        "command": "gitglasses.gitCommands",
        "title": "Git Commands…",
        "category": "GitGlasses",
        "icon": "$(source-control)",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "gitglasses.interactiveRebase",
        "title": "Interactive Rebase…",
        "category": "GitGlasses",
        "enablement": "isWorkspaceTrusted && gitglasses.engineFullCapabilities"
      },
      {
        "command": "gitglasses.worktrees.add",
        "title": "Add Worktree…",
        "category": "GitGlasses",
        "icon": "$(add)",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "gitglasses.worktrees.open",
        "title": "Open in New Window",
        "category": "GitGlasses",
        "icon": "$(empty-window)"
      },
      {
        "command": "gitglasses.worktrees.remove",
        "title": "Remove Worktree",
        "category": "GitGlasses",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "gitglasses.connectIntegration",
        "title": "Connect Integration…",
        "category": "GitGlasses"
      },
      {
        "command": "gitglasses.disconnectIntegration",
        "title": "Disconnect Integration…",
        "category": "GitGlasses"
      },
      {
        "command": "gitglasses.startWork",
        "title": "Start Work on Issue…",
        "category": "GitGlasses",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "gitglasses.launchpad.refresh",
        "title": "Refresh Launchpad",
        "category": "GitGlasses",
        "icon": "$(refresh)"
      },
      {
        "command": "gitglasses.launchpad.open",
        "title": "Open in Browser",
        "category": "GitGlasses"
      },
      {
        "command": "gitglasses.launchpad.copyUrl",
        "title": "Copy URL",
        "category": "GitGlasses"
      },
      {
        "command": "gitglasses.launchpad.snooze",
        "title": "Snooze",
        "category": "GitGlasses"
      },
      {
        "command": "gitglasses.launchpad.unsnooze",
        "title": "Unsnooze",
        "category": "GitGlasses"
      },
      {
        "command": "gitglasses.ai.explainCommit",
        "title": "AI Explain Commit",
        "category": "GitGlasses",
        "icon": "$(sparkle)"
      },
      {
        "command": "gitglasses.ai.explainWip",
        "title": "AI Explain Working Changes",
        "category": "GitGlasses",
        "icon": "$(sparkle)"
      },
      {
        "command": "gitglasses.ai.generateCommitMessage",
        "title": "AI Generate Commit Message",
        "category": "GitGlasses",
        "icon": "$(sparkle)",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "gitglasses.ai.nlSearch",
        "title": "AI Search Commits (Natural Language)",
        "category": "GitGlasses",
        "icon": "$(sparkle)"
      },
      {
        "command": "gitglasses.ai.setApiKey",
        "title": "Set AI API Key…",
        "category": "GitGlasses"
      },
      {
        "command": "gitglasses.ai.clearApiKey",
        "title": "Clear AI API Key…",
        "category": "GitGlasses"
      },
      {
        "command": "gitglasses.createPatch",
        "title": "Create Patch…",
        "category": "GitGlasses",
        "enablement": "isWorkspaceTrusted && gitglasses.engineFullCapabilities"
      },
      {
        "command": "gitglasses.applyPatch",
        "title": "Apply Patch…",
        "category": "GitGlasses",
        "enablement": "isWorkspaceTrusted && gitglasses.engineFullCapabilities"
      },
      {
        "command": "gitglasses.suggestChange",
        "title": "Suggest Change for Pull Request…",
        "category": "GitGlasses",
        "enablement": "isWorkspaceTrusted && gitglasses.engineFullCapabilities"
      },
      {
        "command": "gitglasses.switchMode",
        "title": "Switch Mode…",
        "category": "GitGlasses"
      },
      {
        "command": "gitglasses.home.push",
        "title": "Push",
        "category": "GitGlasses",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "gitglasses.home.pull",
        "title": "Pull",
        "category": "GitGlasses",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "gitglasses.home.switchBranch",
