{
  "name": "gitglasses",
  "displayName": "GitGlasses",
  "description": "Open-source git supercharger: inline blame, history, and more — powered by a native engine",
  "version": "0.1.2",
  "publisher": "gitglasses",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/danielwoz/gitglasses.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "SCM Providers",
    "Visualization",
    "Education",
    "Other"
  ],
  "keywords": [
    "git",
    "blame",
    "commit graph",
    "history",
    "worktrees",
    "gitlens"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "browser": "./dist/web/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "gitglasses.toggleLineBlame",
        "title": "GitGlasses: Toggle Inline Blame"
      },
      {
        "command": "gitglasses.toggleFileBlame",
        "title": "GitGlasses: Toggle File Blame Annotations"
      },
      {
        "command": "gitglasses.toggleHeatmap",
        "title": "GitGlasses: Toggle File Heatmap Annotations"
      },
      {
        "command": "gitglasses.clearAnnotations",
        "title": "GitGlasses: Clear File Annotations"
      },
      {
        "command": "gitglasses.diffWithHead",
        "title": "GitGlasses: Open Changes with HEAD"
      },
      {
        "command": "gitglasses.openFileAtRevision",
        "title": "GitGlasses: Open File at Revision"
      },
      {
        "command": "gitglasses.restartEngine",
        "title": "GitGlasses: Restart Engine"
      },
      {
        "command": "gitglasses.refreshViews",
        "title": "GitGlasses: Refresh Views",
        "icon": "$(refresh)"
      },
      {
        "command": "gitglasses.searchCommits",
        "title": "GitGlasses: Search Commits…",
        "icon": "$(search)"
      },
      {
        "command": "gitglasses.showLineHistory",
        "title": "GitGlasses: Show Line History for Selection"
      },
      {
        "command": "gitglasses.copySha",
        "title": "Copy SHA"
      },
      {
        "command": "gitglasses.openCommitDiff",
        "title": "Open Commit"
      },
      {
        "command": "gitglasses.showGraph",
        "title": "GitGlasses: Show Commit Graph",
        "icon": "$(git-branch)"
      },
      {
        "command": "gitglasses.showFileHistory",
        "title": "GitGlasses: Show Visual File History",
        "icon": "$(graph-scatter)"
      },
      {
        "command": "gitglasses.groups.create",
        "title": "GitGlasses: Create Repo Group from Workspace"
      },
      {
        "command": "gitglasses.groups.open",
        "title": "GitGlasses: Open Repo Group in New Window"
      },
      {
        "command": "gitglasses.groups.delete",
        "title": "GitGlasses: Delete Repo Group"
      },
      {
        "command": "gitglasses.groups.export",
        "title": "GitGlasses: Export Repo Group…"
      },
      {
        "command": "gitglasses.groups.import",
        "title": "GitGlasses: Import Repo Group…"
      },
      {
        "command": "gitglasses.gitCommands",
        "title": "GitGlasses: Git Commands…",
        "icon": "$(source-control)"
      },
      {
        "command": "gitglasses.interactiveRebase",
        "title": "GitGlasses: Interactive Rebase…",
        "enablement": "gitglasses.engineFullCapabilities"
      },
      {
        "command": "gitglasses.worktrees.add",
        "title": "GitGlasses: Add Worktree…",
        "icon": "$(add)"
      },
      {
        "command": "gitglasses.worktrees.open",
        "title": "Open in New Window",
        "icon": "$(empty-window)"
      },
      {
        "command": "gitglasses.worktrees.remove",
        "title": "Remove Worktree"
      },
      {
        "command": "gitglasses.connectIntegration",
        "title": "GitGlasses: Connect Integration…"
      },
      {
        "command": "gitglasses.disconnectIntegration",
        "title": "GitGlasses: Disconnect Integration…"
      },
      {
        "command": "gitglasses.startWork",
        "title": "GitGlasses: Start Work on Issue…"
      },
      {
        "command": "gitglasses.launchpad.refresh",
        "title": "GitGlasses: Refresh Launchpad",
        "icon": "$(refresh)"
      },
      {
        "command": "gitglasses.launchpad.open",
        "title": "Open in Browser"
      },
      {
        "command": "gitglasses.launchpad.copyUrl",
        "title": "Copy URL"
      },
      {
        "command": "gitglasses.launchpad.snooze",
        "title": "Snooze"
      },
      {
        "command": "gitglasses.launchpad.unsnooze",
        "title": "Unsnooze"
      },
      {
        "command": "gitglasses.ai.explainCommit",
        "title": "GitGlasses: AI Explain Commit",
        "icon": "$(sparkle)"
      },
      {
        "command": "gitglasses.ai.explainWip",
        "title": "GitGlasses: AI Explain Working Changes",
        "icon": "$(sparkle)"
      },
      {
        "command": "gitglasses.ai.generateCommitMessage",
        "title": "GitGlasses: AI Generate Commit Message",
        "icon": "$(sparkle)"
      },
      {
        "command": "gitglasses.ai.nlSearch",
        "title": "GitGlasses: AI Search Commits (Natural Language)",
        "icon": "$(sparkle)"
      },
      {
        "command": "gitglasses.ai.setApiKey",
        "title": "GitGlasses: Set AI API Key…"
      },
      {
        "command": "gitglasses.ai.clearApiKey",
        "title": "GitGlasses: Clear AI API Key…"
      },
      {
        "command": "gitglasses.createPatch",
        "title": "GitGlasses: Create Patch…",
        "enablement": "gitglasses.engineFullCapabilities"
      },
      {
        "command": "gitglasses.applyPatch",
        "title": "GitGlasses: Apply Patch…",
        "enablement": "gitglasses.engineFullCapabilities"
      },
      {
        "command": "gitglasses.suggestChange",
        "title": "GitGlasses: Suggest Change for Pull Request…",
        "enablement": "gitglasses.engineFullCapabilities"
      },
      {
        "command": "gitglasses.switchMode",
        "title": "GitGlasses: Switch Mode…"
      },
      {
        "command": "gitglasses.home.push",
        "title": "GitGlasses: Push"
      },
      {
        "command": "gitglasses.home.pull",
        "title": "GitGlasses: Pull"
      },
      {
        "command": "gitglasses.home.switchBranch",
        "title": "GitGlasses: Switch Branch…"
      },
      {
        "command": "gitglasses.home.createBranch",
        "title": "GitGlasses: Create Branch…"
      },
      {
        "command": "gitglasses.home.dismissGetStarted",
        "title": "Dismiss Get Started"
      },
      {
        "command": "gitglasses.openWalkthrough",
        "title": "GitGlasses: Get Started"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gitglasses",
          "title": "GitGlasses",
          "icon": "media/gitglasses.svg"
        }
      ]
    },
    "views": {
      "gitglasses": [
        {
          "id": "gitglasses.views.home",
          "name": "Home"
        },
        {
          "id": "gitglasses.views.launchpad",
          "name": "Launchpad"
        },
        {
          "id": "gitglasses.views.commits",
          "name": "Commits"
        },
        {
          "id": "gitglasses.views.branches",
          "name": "Branches"
        },
        {
          "id": "gitglasses.views.remotes",
          "name": "Remotes"
        },
        {
          "id": "gitglasses.views.stashes",
          "name": "Stashes"
        },
        {
          "id": "gitglasses.views.tags",
          "name": "Tags"
        },
        {
          "id": "gitglasses.views.fileHistory",
          "name": "File History"
        },
        {
          "id": "gitglasses.views.searchCompare",
          "name": "Search & Compare"
        },
        {
          "id": "gitglasses.views.contributors",
          "name": "Contributors"
        },
        {
          "id": "gitglasses.views.worktrees",
          "name": "Worktrees"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "gitglasses.views.searchCompare",
        "contents": "Search commits by message text or SHA.\n[Search Commits…](command:gitglasses.searchCommits)\n\nOr describe what you are looking for in plain language.\n[AI Search Commits…](command:gitglasses.ai.nlSearch)"
      },
      {
        "view": "gitglasses.views.home",
        "contents": "The Commit Graph is the fastest way to see how this repository fits together.\n[Show Commit Graph](command:gitglasses.showGraph)\n\nNew to GitGlasses? Take the tour.\n[Get Started](command:gitglasses.openWalkthrough)"
      },
      {
        "view": "gitglasses.views.worktrees",
        "contents": "Worktrees let you check out several branches at once, without stashing.\n[Add Worktree…](command:gitglasses.worktrees.add)"
      },
      {
        "view": "gitglasses.views.stashes",
        "contents": "No stashes yet. Stashes you create will appear here."
      },
      {
        "view": "gitglasses.views.launchpad",
        "contents": "Launchpad collects your pull requests and issues in one place.\n[Connect an Integration…](command:gitglasses.connectIntegration)\n\nIntegrations are free and work with self-hosted servers. No account required."
      },
      {
        "view": "gitglasses.views.fileHistory",
        "contents": "Open a file to see its history here.\n[Show Visual File History](command:gitglasses.showFileHistory)"
      }
    ],
    "walkthroughs": [
      {
        "id": "gitglasses.getStarted",
        "title": "Get Started with GitGlasses",
        "description": "Every feature is free and works offline. There is no account to create and nothing to sign in to.",
        "steps": [
          {
            "id": "graph",
            "title": "Read your history in the Commit Graph",
            "description": "The graph shows branches, merges and authorship together, on public and private repositories alike.\n[Show Commit Graph](command:gitglasses.showGraph)",
            "media": {
              "markdown": "media/walkthrough/graph.md"
            },
            "completionEvents": [
              "onCommand:gitglasses.showGraph"
            ]
          },
          {
            "id": "blame",
            "title": "See who changed a line, as you type",
            "description": "Inline blame annotates the current line. File blame and the heatmap annotate the whole file.\n[Toggle Inline Blame](command:gitglasses.toggleLineBlame)",
            "media": {
              "markdown": "media/walkthrough/blame.md"
            },
            "completionEvents": [
              "onCommand:gitglasses.toggleLineBlame"
            ]
          },
          {
            "id": "fileHistory",
            "title": "Trace a file over time",
            "description": "Visual File History plots each revision by size and author, so churn is obvious at a glance.\n[Show Visual File History](command:gitglasses.showFileHistory)",
            "media": {
              "markdown": "media/walkthrough/history.md"
            },
            "completionEvents": [
              "onCommand:gitglasses.showFileHistory"
            ]
          },
          {
            "id": "worktrees",
            "title": "Work on two branches at once",
            "description": "Worktrees check out another branch in a separate folder, so you can review a pull request without stashing.\n[Add Worktree…](command:gitglasses.worktrees.add)",
            "media": {
              "markdown": "media/walkthrough/worktrees.md"
            },
            "completionEvents": [
              "onCommand:gitglasses.worktrees.add"
            ]
          },
          {
            "id": "ai",
            "title": "Bring your own AI key, or none at all",
            "description": "Explain a commit or draft a commit message using your own API key or a local Ollama model. Nothing is metered and nothing is sent to us.\n[Set AI API Key…](command:gitglasses.ai.setApiKey)",
            "media": {
              "markdown": "media/walkthrough/ai.md"
            },
            "completionEvents": [
              "onCommand:gitglasses.ai.setApiKey",
              "onCommand:gitglasses.ai.explainCommit"
            ]
          },
          {
            "id": "integrations",
            "title": "Connect issues and pull requests",
            "description": "Launchpad gathers your pull requests and issues. Self-hosted servers are supported and cost nothing.\n[Connect an Integration…](command:gitglasses.connectIntegration)",
            "media": {
              "markdown": "media/walkthrough/integrations.md"
            },
            "completionEvents": [
              "onCommand:gitglasses.connectIntegration"
            ]
          }
        ]
      }
    ],
    "keybindings": [
      {
        "command": "gitglasses.showGraph",
        "key": "ctrl+shift+g g",
        "mac": "cmd+shift+g g"
      },
      {
        "command": "gitglasses.toggleLineBlame",
        "key": "ctrl+shift+g b",
        "mac": "cmd+shift+g b",
        "when": "editorTextFocus"
      },
      {
        "command": "gitglasses.toggleFileBlame",
        "key": "ctrl+shift+g shift+b",
        "mac": "cmd+shift+g shift+b",
        "when": "editorTextFocus"
      },
      {
        "command": "gitglasses.showFileHistory",
        "key": "ctrl+shift+g h",
        "mac": "cmd+shift+g h",
        "when": "editorTextFocus"
      },
      {
        "command": "gitglasses.searchCommits",
        "key": "ctrl+shift+g f",
        "mac": "cmd+shift+g f"
      },
      {
        "command": "gitglasses.gitCommands",
        "key": "ctrl+shift+g c",
        "mac": "cmd+shift+g c"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "gitglasses.showGraph",
          "when": "view =~ /^gitglasses\\.views\\./",
          "group": "navigation@0"
        },
        {
          "command": "gitglasses.refreshViews",
          "when": "view =~ /^gitglasses\\.views\\./ && view != gitglasses.views.launchpad",
          "group": "navigation"
        },
        {
          "command": "gitglasses.launchpad.refresh",
          "when": "view == gitglasses.views.launchpad",
          "group": "navigation"
        },
        {
          "command": "gitglasses.searchCommits",
          "when": "view == gitglasses.views.searchCompare",
          "group": "navigation"
        },
        {
          "command": "gitglasses.showGraph",
          "when": "view == gitglasses.views.commits",
          "group": "navigation"
        },
        {
          "command": "gitglasses.worktrees.add",
          "when": "view == gitglasses.views.worktrees",
          "group": "navigation"
        },
        {
          "command": "gitglasses.showFileHistory",
          "when": "view == gitglasses.views.fileHistory",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "gitglasses.showFileHistory",
          "when": "resourceScheme == file",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "gitglasses.suggestChange",
          "when": "editorHasSelection && resourceScheme == file",
          "group": "gitglasses@1"
        }
      ],
      "view/item/context": [
        {
          "command": "gitglasses.copySha",
          "when": "view =~ /^gitglasses\\.views\\./ && viewItem =~ /^gitglasses(Commit|FileHistoryEntry|Branch|CurrentBranch|RemoteBranch|Tag|Stash)$/"
        },
        {
          "command": "gitglasses.openCommitDiff",
          "when": "view =~ /^gitglasses\\.views\\./ && viewItem =~ /^gitglasses(Commit|FileHistoryEntry)$/"
        },
        {
          "command": "gitglasses.ai.explainCommit",
          "when": "view =~ /^gitglasses\\.views\\./ && viewItem == gitglassesCommit"
        },
        {
          "command": "gitglasses.createPatch",
          "when": "view =~ /^gitglasses\\.views\\./ && viewItem =~ /^gitglasses(Commit|Stash)$/"
        },
        {
          "command": "gitglasses.worktrees.open",
          "when": "view == gitglasses.views.worktrees && viewItem =~ /^gitglasses(Current)?Worktree$/",
          "group": "inline"
        },
        {
          "command": "gitglasses.worktrees.open",
          "when": "view == gitglasses.views.worktrees && viewItem =~ /^gitglasses(Current)?Worktree$/"
        },
        {
          "command": "gitglasses.worktrees.remove",
          "when": "view == gitglasses.views.worktrees && viewItem == gitglassesWorktree"
        },
        {
          "command": "gitglasses.launchpad.open",
          "when": "view == gitglasses.views.launchpad && viewItem =~ /^gitglassesLaunchpad(Snoozed)?Pr$/"
        },
        {
          "command": "gitglasses.launchpad.copyUrl",
          "when": "view == gitglasses.views.launchpad && viewItem =~ /^gitglassesLaunchpad(Snoozed)?Pr$/"
        },
        {
          "command": "gitglasses.launchpad.snooze",
          "when": "view == gitglasses.views.launchpad && viewItem == gitglassesLaunchpadPr"
        },
        {
          "command": "gitglasses.launchpad.unsnooze",
          "when": "view == gitglasses.views.launchpad && viewItem == gitglassesLaunchpadSnoozedPr"
        }
      ],
      "commandPalette": [
        {
          "command": "gitglasses.suggestChange",
          "when": "editorHasSelection"
        },
        {
          "command": "gitglasses.copySha",
          "when": "false"
        },
        {
          "command": "gitglasses.openCommitDiff",
          "when": "false"
        },
        {
          "command": "gitglasses.worktrees.open",
          "when": "false"
        },
        {
          "command": "gitglasses.worktrees.remove",
          "when": "false"
        },
        {
          "command": "gitglasses.launchpad.open",
          "when": "false"
        },
        {
          "command": "gitglasses.launchpad.copyUrl",
          "when": "false"
        },
        {
          "command": "gitglasses.launchpad.snooze",
          "when": "false"
        },
        {
          "command": "gitglasses.launchpad.unsnooze",
          "when": "false"
        },
        {
          "command": "gitglasses.home.push",
          "when": "false"
        },
        {
          "command": "gitglasses.home.pull",
          "when": "false"
        },
        {
          "command": "gitglasses.home.switchBranch",
          "when": "false"
        },
        {
          "command": "gitglasses.home.createBranch",
          "when": "false"
        },
        {
          "command": "gitglasses.home.dismissGetStarted",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "GitGlasses",
      "properties": {
        "gitglasses.mode": {
          "type": "string",
          "enum": [
            "normal",
            "zen",
            "review"
          ],
          "enumDescriptions": [
            "Annotations and CodeLens follow their individual settings",
            "Distraction-free: hide inline blame, status bar blame, file annotations, and blame CodeLens",
            "Review: gutter blame annotations forced on in the editors you open"
          ],
          "default": "normal",
          "description": "GitGlasses mode; switch via the status bar item or the Switch Mode command"
        },
        "gitglasses.currentLine.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show blame annotation for the current line"
        },
        "gitglasses.fileAnnotations.dateFormat": {
          "type": "string",
          "default": "relative",
          "description": "Date format for file annotations (only 'relative' is supported for now)"
        },
        "gitglasses.codeLens.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show git blame CodeLens above files and top-level symbols"
        },
        "gitglasses.engine.path": {
          "type": "string",
          "default": "",
          "description": "Path to gitglasses-engine (defaults to the bundled binary)"
        },
        "gitglasses.web.maxRepoBytes": {
          "type": "number",
          "default": 209715200,
          "description": "Web only: maximum total bytes mirrored into the in-memory wasm engine before GitGlasses aborts with an error (default 200 MB)"
        },
        "gitglasses.engine.logLevel": {
          "type": "string",
          "enum": [
            "trace",
            "debug",
            "info",
            "warn",
            "error"
          ],
          "default": "warn",
          "description": "Engine log level (logs go to the GitGlasses output channel)"
        },
        "gitglasses.integrations.hosts": {
          "type": "array",
          "default": [],
          "description": "Self-hosted git hosting instances, e.g. [{ \"domain\": \"github.example.com\", \"provider\": \"github-enterprise\" }]",
          "items": {
            "type": "object",
            "required": [
              "domain",
              "provider"
            ],
            "properties": {
              "domain": {
                "type": "string",
                "description": "Hostname of the instance, e.g. github.example.com"
              },
              "provider": {
                "type": "string",
                "description": "Provider id serving this domain, e.g. github-enterprise, gitlab"
              }
            }
          }
        },
        "gitglasses.integrations.issues": {
          "type": "array",
          "default": [],
          "description": "Issue tracker integrations, e.g. [{ \"provider\": \"jira\", \"host\": \"mycompany.atlassian.net\" }]",
          "items": {
            "type": "object",
            "required": [
              "provider"
            ],
            "properties": {
              "provider": {
                "type": "string",
                "description": "Issue provider id: jira or linear"
              },
              "host": {
                "type": "string",
                "description": "Provider host, when applicable (e.g. mycompany.atlassian.net)"
              }
            }
          }
        },
        "gitglasses.ai.provider": {
          "type": "string",
          "enum": [
            "vscode-lm",
            "anthropic",
            "openai",
            "gemini",
            "ollama"
          ],
          "enumDescriptions": [
            "VS Code Language Model API (GitHub Copilot) — zero configuration when available",
            "Anthropic Claude API (bring your own key)",
            "OpenAI API or any compatible endpoint (bring your own key)",
            "Google Gemini API (bring your own key)",
            "Local Ollama server — no key, data stays on your machine"
          ],
          "default": "vscode-lm",
          "description": "AI provider used by the GitGlasses AI commands"
        },
        "gitglasses.ai.model": {
          "type": "string",
          "default": "",
          "description": "Model id for the selected AI provider (empty = provider default)"
        },
        "gitglasses.ai.openai.baseUrl": {
          "type": "string",
          "default": "",
          "description": "Base URL for OpenAI-compatible endpoints (empty = https://api.openai.com/v1)"
        },
        "gitglasses.ai.ollama.host": {
          "type": "string",
          "default": "",
          "description": "Ollama server URL (empty = http://localhost:11434)"
        },
        "gitglasses.autolinks": {
          "type": "array",
          "default": [],
          "description": "Custom autolink patterns applied to commit messages, e.g. [{ \"regex\": \"TICKET-(\\\\d+)\", \"urlTemplate\": \"https://tracker.example.com/browse/TICKET-$1\" }]",
          "items": {
            "type": "object",
            "required": [
              "regex",
              "urlTemplate"
            ],
            "properties": {
              "regex": {
                "type": "string",
                "description": "Regular expression matching the reference text"
              },
              "urlTemplate": {
                "type": "string",
                "description": "Target URL; capture groups referenced as $1, $2, …"
              }
            }
          }
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "test": "vitest run",
    "test:e2e": "node esbuild.mjs && tsc -p test-e2e/tsconfig.json && node test-e2e/headless.cjs",
    "test:web": "node esbuild.mjs && node test-web/runTests.mjs",
    "package": "vsce package --no-dependencies"
  },
  "dependencies": {
    "@gitglasses/integrations": "workspace:*",
    "@gitglasses/protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/test-web": "^0.0.81",
    "@vscode/vsce": "^3.0.0",
