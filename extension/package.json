        "icon": "$(globe)"
      },
      {
        "command": "gitglasses.copyRemoteUrl",
        "title": "Copy Remote File URL",
        "category": "GitGlasses"
      },
      {
        "command": "gitglasses.openCommitOnRemote",
        "title": "Open Commit on Remote",
        "category": "GitGlasses"
      },
      {
        "command": "gitglasses.stageSelectedHunks",
        "title": "Stage Selected Hunk(s)",
