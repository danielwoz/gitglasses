        "title": "GitGlasses: Add Integration…"
      },
      {
        "command": "gitglasses.removeIntegration",
        "title": "GitGlasses: Remove Integration…"
      },
      {
        "command": "gitglasses.selectRepository",
        "title": "GitGlasses: Select Repository…",
        "icon": "$(repo)"
      }
