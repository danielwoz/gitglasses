      },
      {
        "command": "gitglasses.unstageSelectedHunks",
        "title": "Unstage Selected Hunk(s)",
        "category": "GitGlasses",
        "enablement": "isWorkspaceTrusted && gitglasses.engineFullCapabilities"
      },
      {
